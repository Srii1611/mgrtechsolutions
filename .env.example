# Resend API key. Create at https://resend.com → API Keys.
# Without this the lead form returns 503 and tells the visitor to call.
RESEND_API_KEY=

# Verified sending address on the Resend-verified domain.
# Must be on a domain verified in Resend, e.g. site@mgrtechsolutionsinc.com
LEAD_FROM_EMAIL=

# Where leads are delivered. Defaults to the site email (SITE.email) if unset.
# Use this to route leads elsewhere for testing, or to a different inbox later.
# Only the Resend account owner's address works when using the shared test sender.
LEAD_TO_EMAIL=
